{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lorelei",
  "version": "0.1.0",
  "identifier": "jp.outcasts.lorelei",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../out"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Lorelei",
        "width": 1280,
        "height": 840,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost",
      "dangerousDisableAssetCspModification": [
        "style-src"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../LICENSE": "licenses/LICENSE-Lorelei.txt",
      "../crates/lorelei_core/fonts/OFL.txt": "licenses/NotoSansJP-OFL.txt",
      "../vendor/merman-core/LICENSE-MIT": "licenses/merman-LICENSE-MIT.txt",
      "../vendor/merman-core/LICENSE-APACHE": "licenses/merman-LICENSE-APACHE.txt"
    }
  }
}
